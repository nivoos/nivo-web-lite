# The secrets this package needs, by name. Generated by `nivoos package secrets init`: commit it, never put a value in it.
# To deploy: copy it to <name>.secrets.env (git ignores that name), set the env line below to dev or prod, fill every value.
# env: <dev|prod>

# zalo-main accessToken (required)
ZALO_MAIN_ACCESS_TOKEN=

# zalo-main oaSecretKey (required)
ZALO_MAIN_OA_SECRET_KEY=
